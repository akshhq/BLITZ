# Recommended response headers for the admin folder (https://keshav.du.ac.in/blitz/prezi_panel/).
# Give this to whoever runs the web server. Rename to .htaccess if the server is Apache with
# mod_headers enabled. For nginx, set the same headers with add_header inside the location block.
#
# The panel already has a strict Content-Security-Policy in its HTML; these headers add things a
# <meta> tag cannot do (stop other sites from embedding the panel, never cache it).
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

# nginx equivalent:
#   location /blitz/prezi_panel/ {
#     add_header X-Frame-Options "SAMEORIGIN" always;
#     add_header Content-Security-Policy "frame-ancestors 'self'" always;
#     add_header Cache-Control "no-store" always;
#     add_header X-Content-Type-Options "nosniff" always;
#     add_header Referrer-Policy "no-referrer" always;
#   }
